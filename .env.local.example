# ============================================
# CEPE Grills & Diner — Environment Variables
# Copy to .env.local and fill in real values.
# ============================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/cepe_grills"

# --- Paystack ---
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Pusher / Real-time ---
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# --- Africa's Talking (OTP + SMS) ---
AT_API_KEY="your_africastalking_api_key"
AT_USERNAME="sandbox"

# --- JWT (min 32 random chars) ---
JWT_SECRET="change_me_to_a_32_char_random_secret_!!!"

# --- KDS Bearer Token ---
KDS_SECRET="change_me_kitchen_secret_token"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DELIVERY_FEE_PESEWAS="2000"
